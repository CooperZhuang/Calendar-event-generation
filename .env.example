# ================================================================
#  Schedule Agent 配置文件
#  复制此文件为 .env 并填入真实值：cp .env.example .env
# ================================================================

# ── iCloud 日历订阅 ─────────────────────────────────────────────
# iCloud 日历的已发布（public）链接，用于去重 + 自动发现新地点
# 获取方式：日历 App → 右键日历 → 共享 → 公开日历 → 复制链接
CALENDAR_URL=webcal://...

# ── AI 解析（默认模式）──────────────────────────────────────────
# 程序默认进入 AI 模式：Cmd+V 粘贴截图 / 自由文本，AI 提取日程生成 .ics

# API Key（必填）。兼容 OpenAI 及任何 OpenAI-兼容接口（DeepSeek、Qwen 等）
OPENAI_API_KEY=sk-...

# API 地址（可选）。默认为 OpenAI 官方
# OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称（可选）。默认 gpt-4o，需支持视觉能力才能解析图片
# OPENAI_MODEL=gpt-4o
